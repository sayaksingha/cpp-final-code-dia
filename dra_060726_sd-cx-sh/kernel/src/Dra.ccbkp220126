//-------------------------------------------------------------------------------
// METHOD      : ResetRequestReceived
// DESCRIPTION : Handles S6a Reset Request (RSR) from HSS to MME/SGSN.
//               HSS-initiated request to reset UE context. Routes back to
//               the MME that has the subscriber registered.
//               Per 3GPP TS 29.272 Section 7.2.15
// PARAMETER   : DiameterMsg *msg - RSR message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::ResetRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	
	// Try reverse routing first (preferred for HSS-initiated messages)
	if (mSourcePeerEntry != nullptr && mRouting->CheckPeerStatus(mSourcePeerEntry))
	{
		dest = mSourcePeerEntry;
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a RSR: Reverse routing to stored MME\n", lLogText.c_str()));
	}
	else
	{
		// Fallback to standard DRA routing if reverse routing unavailable
		if (mSourcePeerEntry)
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a RSR: Stored peer unavailable, using fallback routing\n", lLogText.c_str()));
		else
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a RSR: No stored peer, using fallback routing\n", lLogText.c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a RSR: AVP-based routing\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a RSR: No active MME peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a RSR: Session-based routing\n", lLogText.c_str()));

			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a RSR: All MME peers unavailable\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a RSR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a RSR: HSS[%s] → MME[%s] (Reset Request)\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), dest->GetPeerName().c_str()));
}

void Dra::ResetAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a RSA: SUCCESS - Reset acknowledged\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a RSA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a RSA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a RSA: Exception processing answer\n", lLogText.c_str()));
	}
}

void Dra::NotifyRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a NOR: AVP-based routing\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a NOR: No active HSS peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a NOR: Session-based routing\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a NOR: All HSS peers unavailable\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a NOR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a NOR: MME[%s] → HSS[%s] (Notification)\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

void Dra::NotifyAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a NOA: SUCCESS - Notification acknowledged\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a NOA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a NOA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a NOA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a NOA: Exception processing answer\n", lLogText.c_str()));
	}
}

