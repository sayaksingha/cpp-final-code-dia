//-------------------------------------------------------------------------------
void Dra::ccRAAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
}

//-------------------------------------------------------------------------------
// METHOD      : ccASRequestReceived
// DESCRIPTION : Handles the processing of an ASR in the Diameter protocol.
// 				 It determines the appropriate destination peer, performs routing
//				 checks, and updates the message's destination information.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccASRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	dest = mSourcePeerEntry;
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (DRA_CONFIG_HDLR()->mRelayDataOnErrToPcrfFlg)
	{
		if (DRA_CONFIG_HDLR()->mRelayAsrToPcrfFlg)
		{
			this->RelayASRToPcrf(msg);
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s ASR Relay to pcrf Flag:%d Disabled\n", lLogText.c_str(), DRA_CONFIG_HDLR()->mRelayAsrToPcrfFlg));
		}
	}

	regex lRegex((DRA_CONFIG_HDLR()->mOHAsrRelayCfg));
	string lOriginHost = msg->baseClass->getOriginHost()->ToString();
	if (regex_match(lOriginHost, lRegex))
	{
		if (DRA_CONFIG_HDLR()->mDoNotRelay_asr)
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s ASR Not relaying to Dest\n", lLogText.c_str()));

			if (DRA_CONFIG_HDLR()->mDrop_asr)
			{
				DIAMETER_CFG_RELOAD()->drop_asr = true;
				msg->internalRspFlag = true;
			}
			else
			{
				DIAMETER_CFG_RELOAD()->ack_asr = true;
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Sending ACK for ASR FROM DRA\n", lLogText.c_str()));
				this->FormASAnswer(msg);
				dest = mDestPeerEntry;
			}
		}
	}

	if (dest)
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s ASR Source:%s Route to Destination:%s\n", lLogText.c_str(),
				 source->GetPeerName().c_str(), dest->GetPeerName().c_str()));

	if (true != mRouting->CheckPeerStatus(dest))
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Destination Peer is UNAVAILABLE \n ", lLogText.c_str()));

		if (DIAMETER_CFG_TRANSPORT()->ActiveDefPeerFlag)
		{
			mRouting->getActiveDefPeer(dest, msg->sessionId);
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Got Active Default peer %s \n ", lLogText.c_str(),
					 dest->GetPeerName().c_str()));
		}
		else
		{
			if (mDestPeerEntry->GetActionOnRoutNotFound())
			{
				this->FormAnswer(msg);
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Sending ASAnswer Message Back to Server \n ", lLogText.c_str()));
			}
			else
			{
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s can't sent Message \n ", lLogText.c_str()));
			}
		}
	}
	else
	{
		AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s Destination peer is active\n", lLogText.c_str()));
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : FormASAnswer
// DESCRIPTION : To constructs and sends an Abort Session Answer (ASA) in response 
//				 to an Abort Session Request (ASR) in the Diameter protocol.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::FormASAnswer(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	try
	{
		BASE::AbortSessionRequest *lasr = static_cast<BASE::AbortSessionRequest *>(msg->baseClass.get());
		shared_ptr<BASE::AbortSessionAnswer> lasa = make_shared<BASE::AbortSessionAnswer>();

		lasa->setSessionId()->setValue((TEXT *)lasr->getSessionId()->getValue());
		lasa->setOriginRealm()->setValue((TEXT *)lasr->getDestinationRealm()->getValue());

		if (mDestPeerEntry)
			lasa->setOriginHost()->setValue((TEXT *)mDestPeerEntry->GetRealmName().c_str());
		else
			lasa->setOriginHost()->setValue((TEXT *)mSourcePeerEntry->HostEntry().m_Identity.c_str());

		lasa->setVersion(1);
		lasa->setCmdFlag(1);
		lasa->setCmdCode(lasr->getCmdCode());
		lasa->setApplnId(lasr->getApplnId());

		lasa->setHopByHopId(lasr->getHopByHopId());
		lasa->setEndToEndId(lasr->getEndToEndId());
		lasa->setRequestBit(0);
		lasa->setResultCode()->setValue(AAA_SUCCESS);

		msg->hdr.mCmdFlg.rBit = 0;
		msg->hdr.mCmdFlg.eBit = 0;
		msg->hdr.mCmdFlg.tBit = 0;

		msg->baseClass = lasa;
	}
	catch (...)
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception Caugth While Sending ASAnswer \n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : FormAnswer
// DESCRIPTION : To generates appropriate Diameter protocol answers based on
//				 the command code and application ID of the received message.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::FormAnswer(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	UINT32 lCmdCode = msg->hdr.mCmdCode;
	switch (lCmdCode)
	{
	case AAA_ASR_MSG:
	{
		try
		{
			BASE::AbortSessionRequest *lasr = static_cast<BASE::AbortSessionRequest *>(msg->baseClass.get());
			shared_ptr<BASE::AbortSessionAnswer> lasa = make_shared<BASE::AbortSessionAnswer>();

			lasa->setSessionId()->setValue((TEXT *)lasr->getSessionId()->getValue());
			lasa->setOriginRealm()->setValue((TEXT *)lasr->getDestinationRealm()->getValue());
			lasa->setOriginHost()->setValue((TEXT *)lasr->getDestinationHost()->getValue());
			lasa->setVersion(1);
			lasa->setCmdFlag(1);
			lasa->setCmdCode(lasr->getCmdCode());
			lasa->setApplnId(lasr->getApplnId());
			lasa->setHopByHopId(lasr->getHopByHopId());
			lasa->setEndToEndId(lasr->getEndToEndId());
			lasa->setRequestBit(0);
			lasa->setResultCode()->setValue(3002);

			msg->hdr.mCmdFlg.rBit = 0;
			msg->hdr.mCmdFlg.eBit = 0;
			msg->hdr.mCmdFlg.tBit = 0;

			msg->internalRspFlag = true;

			msg->baseClass = lasa;
		}
		catch (...)
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception Caugth While Sending ASAnswer \n", lLogText.c_str()));
		}
	}
	break;
	case AAA_SNR_MSG:
	{
		try
		{
			SY::SNRequest *lsnr = static_cast<SY::SNRequest *>(msg->baseClass.get());
			shared_ptr<SY::SNAnswer> lsna = make_shared<SY::SNAnswer>();

			lsna->setSessionId()->setValue((TEXT *)lsnr->getSessionId()->getValue());
			lsna->setOriginRealm()->setValue((TEXT *)lsnr->getDestinationRealm()->getValue());
			lsna->setOriginHost()->setValue((TEXT *)lsnr->getDestinationHost()->getValue());
			lsna->setVersion(1);
			lsna->setCmdFlag(1);
			lsna->setCmdCode(lsnr->getCmdCode());
			lsna->setApplnId(lsnr->getApplnId());
			lsna->setHopByHopId(lsnr->getHopByHopId());
			lsna->setEndToEndId(lsnr->getEndToEndId());
			lsna->setRequestBit(0);
			lsna->setResultCode()->setValue(3002);

			msg->hdr.mCmdFlg.rBit = 0;
			msg->hdr.mCmdFlg.eBit = 0;
			msg->hdr.mCmdFlg.tBit = 0;

			msg->internalRspFlag = true;

			msg->baseClass = lsna;
		}
		catch (...)
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception Caugth While Forming SNAnswer \n", lLogText.c_str()));
		}
	}
	break;

	case AAA_RAR_MSG:
	{
		switch (msg->hdr.mApplId)
		{
		case AAA_Gx_APP_ID:
		{
			try
			{
				// BASE::ReAuthRequest *lrar = static_cast<BASE::ReAuthRequest*>(msg->baseClass.get());
				GX::RARequest *lrar = static_cast<GX::RARequest *>(msg->baseClass.get());
				// shared_ptr<BASE::ReAuthRequest> lraa = make_shared<BASE::ReAuthRequest>();
				shared_ptr<GX::RAAnswer> lraa = make_shared<GX::RAAnswer>();

				lraa->setSessionId()->setValue((TEXT *)lrar->getSessionId()->getValue());
				lraa->setOriginRealm()->setValue((TEXT *)lrar->getDestinationRealm()->getValue());
				lraa->setOriginHost()->setValue((TEXT *)lrar->getDestinationHost()->getValue());
				lraa->setVersion(1);
				lraa->setCmdFlag(1);
				lraa->setCmdCode(lrar->getCmdCode());
				lraa->setApplnId(lrar->getApplnId());
				lraa->setHopByHopId(lrar->getHopByHopId());
				lraa->setEndToEndId(lrar->getEndToEndId());
				lraa->setRequestBit(0);
				lraa->setResultCode()->setValue(3002);

				msg->hdr.mCmdFlg.rBit = 0;
				msg->hdr.mCmdFlg.eBit = 0;
				msg->hdr.mCmdFlg.tBit = 0;

				msg->internalRspFlag = true;
				msg->baseClass = lraa;
			}
			catch (...)
			{
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception Caugth While Sending RAAnswer \n", lLogText.c_str()));
			}
		}
		break;
		case AAA_Ro_APP_ID:
		{
			try
			{
				// BASE::ReAuthRequest *lrar = static_cast<BASE::ReAuthRequest*>(msg->baseClass.get());
				RO::RARequest *lrar = static_cast<RO::RARequest *>(msg->baseClass.get());
				// shared_ptr<BASE::ReAuthRequest> lraa = make_shared<BASE::ReAuthRequest>();
				shared_ptr<RO::RAAnswer> lraa = make_shared<RO::RAAnswer>();

				lraa->setSessionId()->setValue((TEXT *)lrar->getSessionId()->getValue());
				lraa->setOriginRealm()->setValue((TEXT *)lrar->getDestinationRealm()->getValue());
				lraa->setOriginHost()->setValue((TEXT *)lrar->getDestinationHost()->getValue());
				lraa->setVersion(1);
				lraa->setCmdFlag(1);
				lraa->setCmdCode(lrar->getCmdCode());
				lraa->setApplnId(lrar->getApplnId());
				lraa->setHopByHopId(lrar->getHopByHopId());
				lraa->setEndToEndId(lrar->getEndToEndId());
				lraa->setRequestBit(0);
				lraa->setResultCode()->setValue(3002);

				msg->hdr.mCmdFlg.rBit = 0;
				msg->hdr.mCmdFlg.eBit = 0;
				msg->hdr.mCmdFlg.tBit = 0;

				msg->internalRspFlag = true;
				msg->baseClass = lraa;
			}
			catch (...)
			{
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception Caugth While Sending RAAnswer \n", lLogText.c_str()));
			}
		}
		break;
		default:
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s UNKNOWN COMMAND CODE RECEIVED:%d \n", lLogText.c_str(),
					 msg->hdr.mApplId));
		}
		}
	}
	break;
	default:
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s UNKNOWN COMMAND CODE RECEIVED:%d \n", lLogText.c_str(), lCmdCode));
	}
	}
}

