//-------------------------------------------------------------------------------
// METHOD      : SNRequestReceived
// DESCRIPTION : This method handles the processing of a SNR received in the Diameter protocol.
//               It determines the appropriate destination peer for the message, performs routing
//               checks, and updates the message's destination information.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::SNRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
   std::string lLogText = LOG_DIAMETER_AVPS(*msg);

   dest = mSourcePeerEntry;

   if (dest)
   {
      AAA_LOG((LM_INFO, "%T |DRA_APP| %s SNR Source:%s Route to Destination:%s\n", lLogText.c_str(), source->GetPeerName().c_str(), dest->GetPeerName().c_str()));
      if (true != mRouting->CheckPeerStatus(dest))
      {
         AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Destination Peer is UNAVAILABLE \n ", lLogText.c_str()));
         if (DIAMETER_CFG_TRANSPORT()->ActiveDefPeerFlag)
         {
            mRouting->getActiveDefPeer(dest, msg->sessionId);
            AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Got Active Default peer %s \n ", lLogText.c_str(), dest->GetPeerName().c_str())); // TBC-Anshul 26-12-18
         }
         else
         {
            if (mDestPeerEntry->GetActionOnRoutNotFound())
            {
               this->FormAnswer(msg);
               AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Sending SNR Message Back to Server \n ", lLogText.c_str()));
            }
            else
            {
               AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s can't sent Message \n ", lLogText.c_str()));
            }
         }
      }
      else
      {
         AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Destination Peer is Active\n", lLogText.c_str()));
      }

      try
      {
         msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
         msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
      }
      catch (...)
      {
         AAA_LOG((LM_ERROR, "%T |DRA_APP| %s UL Exception cought while setting Destination identity\n", lLogText.c_str())); /// TBC-Anshul 28-dec
      }
   }
   else
   {
      AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Destination not present\n", lLogText.c_str()));
   }
}
/*{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message, Type:AVP_BASED\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
