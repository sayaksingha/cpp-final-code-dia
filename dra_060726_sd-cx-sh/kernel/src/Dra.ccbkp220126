void Dra::ULRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a ULR: AVP-based routing\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a ULR: No active HSS peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a ULR: Session-based routing\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a ULR: All HSS peers unavailable\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a ULR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a ULR: MME[%s] → HSS[%s]\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

void Dra::ULAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a ULA: SUCCESS - Location updated\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a ULA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a ULA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a ULA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a ULA: Exception processing answer\n", lLogText.c_str()));
	}

}




//-------------------------------------------------------------------------------
// METHOD      : DisplayPegDetailsS6a
// DESCRIPTION : Display S6a protocol performance counters and traffic statistics
// PARAMETER   : DiameterPeerEntry *peerEntry, int index, unsigned long &tps
// RETURN      : void
// THROWS      : None
//-------------------------------------------------------------------------------
void Dra::DisplayPegDetailsS6a(DiameterPeerEntry *peerEntry, int index, unsigned long &tps)
{
	unsigned long cummulatedReq = peerEntry->Peg()->m_cummulatedReq;
	unsigned long cummulatedAns = peerEntry->Peg()->m_cummulatedAns;

	if (false == gClearFlag)
	{
		peerEntry->Peg()->CummulateCount();

		if (peerEntry->Peg()->m_cummulatedReq >= cummulatedReq)
			cummulatedReq = peerEntry->Peg()->m_cummulatedReq - cummulatedReq;
		else
			peerEntry->Peg()->m_cummulatedReq = 0;

		if (peerEntry->Peg()->m_cummulatedAns >= cummulatedAns)
			cummulatedAns = peerEntry->Peg()->m_cummulatedAns - cummulatedAns;
		else
			peerEntry->Peg()->m_cummulatedReq = 0;

		if (cummulatedReq >= 0 && cummulatedAns >= 0)
			tps += (2 * cummulatedReq + 2 * cummulatedAns);
		else
			tps = 0;
	}
	else
	{
		cummulatedReq = 0;
		cummulatedAns = 0;
		peerEntry->Peg()->m_cummulatedReq = 0;
		peerEntry->Peg()->m_cummulatedAns = 0;
		tps = 0;
		gClearFlag = false;
	}

	// S6a message counters: ULR/ULA, AIR/AIA, PUR/PUA, CLR/CLA, IDR/IDA, DSR/DSA
	fprintf(gLicPegS6a,
			"%c> PEER_%02d [%s]  |%-3u|%-3u|%-3u|%-3u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-6u|%-6u|%-6u|%-6u|\n",
			'#',
			index,
			peerEntry->GetPeerStatus().c_str(),
			peerEntry->Peg()->m_cer,           // CER
			peerEntry->Peg()->m_cea_success,   // CEA
			peerEntry->Peg()->m_dwr,           // DWR
			peerEntry->Peg()->m_dwa_success,   // DWA
			peerEntry->Peg()->m_ulr,           // ULR (Update Location Request)
			peerEntry->Peg()->m_ula_success,   // ULA Success
			peerEntry->Peg()->m_ula_fail,      // ULA Fail
			peerEntry->Peg()->m_air,           // AIR (Auth Info Request)
			peerEntry->Peg()->m_aia_success,   // AIA Success
			peerEntry->Peg()->m_aia_fail,      // AIA Fail
			peerEntry->Peg()->m_pur,           // PUR (Purge UE Request)
			peerEntry->Peg()->m_pua_success,   // PUA Success
			peerEntry->Peg()->m_pua_fail,      // PUA Fail
			peerEntry->Peg()->m_clr,           // CLR (Cancel Location Request)
			peerEntry->Peg()->m_cla_success,   // CLA Success
			peerEntry->Peg()->m_cla_fail,      // CLA Fail
			peerEntry->Peg()->m_idr,           // IDR (Insert Subscriber Data Request)
			peerEntry->Peg()->m_ida_success,   // IDA Success
			peerEntry->Peg()->m_ida_fail,      // IDA Fail
			peerEntry->Peg()->m_unexpected,    // Unexpected messages
			peerEntry->Peg()->m_error_bit,     // Error bit set
			peerEntry->Peg()->m_retx_bit,      // Retransmit bit set
			(!peerEntry->IsClient()) ? cummulatedReq : cummulatedAns);  // MSG/SEC

	fflush(gLicPegS6a);
}

//-------------------------------------------------------------------------------
// METHOD      : GenerateFileS6a
// DESCRIPTION : Create S6a traffic statistics file with headers
// PARAMETER   : None
// RETURN      : void
// THROWS      : None
//-------------------------------------------------------------------------------
void Dra::GenerateFileS6a()
{
	time_t lCurrentTime;
	struct tm *lpTmStruct;

	// Close existing file if open
	if (NULL != gLicPegS6a)
	{
		fclose(gLicPegS6a);
		gLicPegS6a = NULL;
	}

	// Generate filename with current date: DDMMYY_DraTraffic_S6A.txt
	lCurrentTime = time(NULL);
	lpTmStruct = localtime(&lCurrentTime);
	snprintf(gLicPegFile, MAX_FILE_PATH + MAX_FILE_NAME, "%s/%02d%02d%02d_DraTraffic_S6A.txt",
			 gLicPegFilePath, lpTmStruct->tm_mday, lpTmStruct->tm_mon + 1, lpTmStruct->tm_year % 100);

	// Open file in append mode
	gLicPegS6a = fopen(gLicPegFile, "a+");

	if (NULL == gLicPegS6a)
	{
		char lLogText[300];
		snprintf(lLogText, 300, "Unable to Open File:%s", gLicPegFile);
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s\n", lLogText));
		return;
	}

	// Print header with peer list
	fprintf(gLicPegS6a, "+----------------------------------------------------------------------+\n");
	std::list<DiameterPeerEntry *> *lPeerList = DIAMETER_PEER_TABLE()->GetPeerList();
	int i = 0;
	for (std::list<DiameterPeerEntry *>::iterator it = lPeerList->begin(); it != lPeerList->end(); it++, i++)
	{
		fprintf(gLicPegS6a, "PEER_%d   :><:  %s [%s]\n", i, (*it)->GetPeerName().c_str(),
				(!(*it)->IsClient()) ? "CLIENT" : "SERVER");
		(*it)->Peg()->ClearPeg();
		gClearFlag = 1;
	}

	// Print column headers for S6a statistics
	fprintf(gLicPegS6a, "+----------------------------------------------------------------------+\n");
	fprintf(gLicPegS6a, "%6s #> %7s |%3s|%3s|%3s|%3s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%6s|%6s|%6s|%6s|\n",
			"Time", "PeerName",
			"CER", "CEA", "DWR", "DWA",           // Connection management
			"ULR", "ULA-S", "ULA-F",              // Update Location
			"AIR", "AIA-S", "AIA-F",              // Auth Info
			"PUR", "PUA-S", "PUA-F",              // Purge UE
			"CLR", "CLA-S", "CLA-F",              // Cancel Location
			"IDR", "IDA-S", "IDA-F",              // Insert Data
			"Unexp", "EBT-R", "TBT-R", "M/S");    // Errors & TPS
	fprintf(gLicPegS6a, "+----------------------------------------------------------------------+\n");

	fprintf(gLicPegS6a, "\n");
}





//-------------------------------------------------------------------------------
// METHOD      : AIRequestReceived
// DESCRIPTION : Handles S6a Authentication Information Request (AIR) from MME/SGSN
//               to HSS. Performs DRA routing and forwards to appropriate HSS.
//               Per 3GPP TS 29.272 Section 7.2.5
// PARAMETER   : DiameterMsg *msg - AIR message
//               DiameterPeerEntry *source - Originating MME/SGSN peer
//               DiameterPeerEntry *&dest - Destination HSS peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::AIRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a AIR: AVP-based routing\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a AIR: No active HSS peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a AIR: Session-based routing\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a AIR: All HSS peers unavailable\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a AIR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a AIR: MME[%s] → HSS[%s]\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

//-------------------------------------------------------------------------------
// METHOD      : AIAnswerReceived
// DESCRIPTION : Handles S6a Authentication Information Answer (AIA) from HSS.
//               Validates result code and logs authentication outcome.
//               Per 3GPP TS 29.272 Section 7.2.6
// PARAMETER   : DiameterMsg *msg - AIA message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::AIAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a AIA: SUCCESS - Authentication vectors provided\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a AIA: USER_UNKNOWN (5001) - IMSI not provisioned\n", lLogText.c_str()));
		}
		else if (resultCode == 5004)  // DIAMETER_ERROR_ROAMING_NOT_ALLOWED
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a AIA: ROAMING_NOT_ALLOWED (5004)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a AIA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else if (resultCode == 5421)  // DIAMETER_ERROR_RAT_NOT_ALLOWED
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a AIA: RAT_NOT_ALLOWED (5421)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a AIA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a AIA: Exception processing answer\n", lLogText.c_str()));
	}
}
//-------------------------------------------------------------------------------
// METHOD      : PURequestReceived
// DESCRIPTION : Handles S6a Purge UE Request (PUR) from MME/SGSN to HSS.
//               Sent when UE is purged from MME due to detach or timeout.
//               Per 3GPP TS 29.272 Section 7.2.13
// PARAMETER   : DiameterMsg *msg - PUR message
//               DiameterPeerEntry *source - Originating MME/SGSN peer
//               DiameterPeerEntry *&dest - Destination HSS peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::PURequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a PUR: AVP-based routing\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a PUR: No active HSS peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a PUR: Session-based routing\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a PUR: All HSS peers unavailable\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a PUR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a PUR: MME[%s] → HSS[%s]\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

//-------------------------------------------------------------------------------
// METHOD      : PUAnswerReceived
// DESCRIPTION : Handles S6a Purge UE Answer (PUA) from HSS.
//               Validates result code and PUA-Flags.
//               Per 3GPP TS 29.272 Section 7.2.14
// PARAMETER   : DiameterMsg *msg - PUA message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::PUAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a PUA: SUCCESS - UE purged from HSS\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a PUA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a PUA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a PUA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a PUA: Exception processing answer\n", lLogText.c_str()));
	}
}
//-------------------------------------------------------------------------------
// METHOD      : CLRequestReceived
// DESCRIPTION : Handles S6a Cancel Location Request (CLR) from HSS to MME/SGSN.
//               HSS-initiated request to cancel UE location. Routes back to
//               the MME that sent the original ULR.
//               Per 3GPP TS 29.272 Section 7.2.7
// PARAMETER   : DiameterMsg *msg - CLR message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::CLRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	
	// Try reverse routing first (preferred for HSS-initiated messages)
	if (mSourcePeerEntry != nullptr && mRouting->CheckPeerStatus(mSourcePeerEntry))
	{
		dest = mSourcePeerEntry;
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a CLR: Reverse routing to stored MME\n", lLogText.c_str()));
	}
	else
	{
		// Fallback to standard DRA routing if reverse routing unavailable
		if (mSourcePeerEntry)
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a CLR: Stored peer unavailable, using fallback routing\n", lLogText.c_str()));
		else
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a CLR: No stored peer, using fallback routing\n", lLogText.c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a CLR: AVP-based routing\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a CLR: No active MME peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a CLR: Session-based routing\n", lLogText.c_str()));

			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a CLR: All MME peers unavailable\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a CLR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a CLR: HSS[%s] → MME[%s] (Cancel Location)\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), dest->GetPeerName().c_str()));
}

//-------------------------------------------------------------------------------
// METHOD      : CLAnswerReceived
// DESCRIPTION : Handles S6a Cancel Location Answer (CLA) from MME/SGSN.
//               Validates cancellation acknowledgment.
//               Per 3GPP TS 29.272 Section 7.2.8
// PARAMETER   : DiameterMsg *msg - CLA message
//               DiameterPeerEntry *source - MME peer
//               DiameterPeerEntry *&dest - Destination HSS peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::CLAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a CLA: SUCCESS - Location cancelled\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a CLA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a CLA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a CLA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a CLA: Exception processing answer\n", lLogText.c_str()));
	}
}
//-------------------------------------------------------------------------------
// METHOD      : IDRequestReceived
// DESCRIPTION : Handles S6a Insert Subscriber Data Request (IDR) from HSS to MME.
//               HSS-initiated request to update subscriber data. Routes back to
//               the MME that registered the subscriber.
//               Per 3GPP TS 29.272 Section 7.2.9
// PARAMETER   : DiameterMsg *msg - IDR message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::IDRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	
	// Try reverse routing first (preferred for HSS-initiated messages)
	if (mSourcePeerEntry != nullptr && mRouting->CheckPeerStatus(mSourcePeerEntry))
	{
		dest = mSourcePeerEntry;
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a IDR: Reverse routing to stored MME\n", lLogText.c_str()));
	}
	else
	{
		// Fallback to standard DRA routing if reverse routing unavailable
		if (mSourcePeerEntry)
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a IDR: Stored peer unavailable, using fallback routing\n", lLogText.c_str()));
		else
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a IDR: No stored peer, using fallback routing\n", lLogText.c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a IDR: AVP-based routing\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a IDR: No active MME peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a IDR: Session-based routing\n", lLogText.c_str()));

			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a IDR: All MME peers unavailable\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a IDR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a IDR: HSS[%s] → MME[%s] (Insert Subscriber Data)\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), dest->GetPeerName().c_str()));
}

//-------------------------------------------------------------------------------
// METHOD      : IDAnswerReceived
// DESCRIPTION : Handles S6a Insert Subscriber Data Answer (IDA) from MME/SGSN.
//               Validates subscriber data insertion acknowledgment.
//               Per 3GPP TS 29.272 Section 7.2.10
// PARAMETER   : DiameterMsg *msg - IDA message
//               DiameterPeerEntry *source - MME peer
//               DiameterPeerEntry *&dest - Destination HSS peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::IDAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		UINT32 resultCode = msg->baseClass->getResultCode()->getValue();

		if (resultCode == 2001)  // DIAMETER_SUCCESS
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a IDA: SUCCESS - Subscriber data inserted\n", lLogText.c_str()));
		}
		else if (resultCode == 5001)  // DIAMETER_ERROR_USER_UNKNOWN
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a IDA: USER_UNKNOWN (5001)\n", lLogText.c_str()));
		}
		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a IDA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
		}
		else if (resultCode == 5428)  // DIAMETER_ERROR_UNKNOWN_SERVING_NODE
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a IDA: UNKNOWN_SERVING_NODE (5428)\n", lLogText.c_str()));
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s S6a IDA: Result-Code=%d\n", lLogText.c_str(), resultCode));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a IDA: Exception processing answer\n", lLogText.c_str()));
	}
}
//-------------------------------------------------------------------------------
// METHOD      : DSRequestReceived
// DESCRIPTION : Handles S6a Delete Subscriber Data Request (DSR) from HSS to MME.
//               HSS-initiated request to delete subscriber data. Routes back to
//               the MME that has the subscriber registered.
//               Per 3GPP TS 29.272 Section 7.2.11
// PARAMETER   : DiameterMsg *msg - DSR message
//               DiameterPeerEntry *source - HSS peer
//               DiameterPeerEntry *&dest - Destination MME peer (output)
// RETURN      : void
// THROWS      : None (exceptions caught internally)
//-------------------------------------------------------------------------------
void Dra::DSRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	
	// Try reverse routing first (preferred for HSS-initiated messages)
	if (mSourcePeerEntry != nullptr && mRouting->CheckPeerStatus(mSourcePeerEntry))
	{
		dest = mSourcePeerEntry;
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a DSR: Reverse routing to stored MME\n", lLogText.c_str()));
	}
	else
	{
		// Fallback to standard DRA routing if reverse routing unavailable
		if (mSourcePeerEntry)
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a DSR: Stored peer unavailable, using fallback routing\n", lLogText.c_str()));
		else
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a DSR: No stored peer, using fallback routing\n", lLogText.c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a DSR: AVP-based routing\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a DSR: No active MME peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s S6a DSR: Session-based routing\n", lLogText.c_str()));

			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a DSR: All MME peers unavailable\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s S6a DSR: Exception setting Destination AVPs\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s S6a DSR: HSS[%s] → MME[%s] (Delete Subscriber Data)\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), dest->GetPeerName().c_str()));
}

