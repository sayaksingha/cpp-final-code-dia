constexpr int DIA_AVP_MSISDN = 44400;
constexpr int DIA_AVP_IMSI = 44401;
constexpr int TERMINATE = 0;

#define MSCC_DECODE()                                                                                                                               \
	try                                                                                                                                             \
	{                                                                                                                                               \
		auto lMSCC = lCCASPtr->getMultipleServicesCreditControlGrpList();                                                                           \
		for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)                                                                                    \
		{                                                                                                                                           \
			int lRG = 0;                                                                                                                            \
			try                                                                                                                                     \
			{                                                                                                                                       \
				lRG = (*it)->getRatingGroup()->getValue();                                                                                          \
			}                                                                                                                                       \
			catch (...)                                                                                                                             \
			{                                                                                                                                       \
				lRG = 0;                                                                                                                            \
			}                                                                                                                                       \
			try                                                                                                                                     \
			{                                                                                                                                       \
				auto lMsccInfoIt = mMsccInfo.find(lRG);                                                                                             \
				if (lMsccInfoIt != mMsccInfo.end())                                                                                                 \
				{                                                                                                                                   \
					lMsccInfoIt->second.mGsuTotal = lMsccInfoIt->second.mGsuTotal + (*it)->getGrantedServiceUnit()->getCCTotalOctets()->getValue(); \
				}                                                                                                                                   \
				else                                                                                                                                \
				{                                                                                                                                   \
					MsccInfo lMsccInfo;                                                                                                             \
					memset(&lMsccInfo, 0, sizeof(lMsccInfo));                                                                                       \
					lMsccInfo.mGsuTotal = (*it)->getGrantedServiceUnit()->getCCTotalOctets()->getValue();                                           \
					mMsccInfo[lRG] = lMsccInfo;                                                                                                     \
				}                                                                                                                                   \
			}                                                                                                                                       \
			catch (...)                                                                                                                             \
			{                                                                                                                                       \
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception While Fetching GSU \n", lLogText.c_str()));                                           \
			}                                                                                                                                       \
		}                                                                                                                                           \
	}                                                                                                                                               \
	catch (...)                                                                                                                                     \
	{                                                                                                                                               \
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Exception While Fetching Mscc for GSU \n", lLogText.c_str()));                                          \
	}

//-------------------------------------------------------------------------------
// METHOD      : Dra
// DESCRIPTION : Parameter Constructor
// PARAMETER   : AAA_Task &task, DraRouting &routing
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
Dra::Dra(AAA_Task &task, DraRouting &routing, int ModuleId) : DiameterGxProxySession(task, ModuleId), mTask(task), mRouting(&routing)
{
	mDestPeerEntry = nullptr;
	mSourcePeerEntry = nullptr;
	mRouting = &routing;
	mModuleId = ModuleId;
}

//-------------------------------------------------------------------------------
// METHOD      : ~Dra
// DESCRIPTION : Destructor
// PARAMETER   :
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
Dra::~Dra()
{
	mDestPeerEntry = nullptr;
	mSourcePeerEntry = nullptr;
}

//-------------------------------------------------------------------------------
// METHOD      : CreateInstance
// DESCRIPTION : CreateInstance of Dra
// PARAMETER   :
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
DiameterGxProxySession *Dra::CreateInstance()
{
	return new Dra(mTask, *(mRouting), mModuleId);
}

//-------------------------------------------------------------------------------
// METHOD      : GetModuleId()
// DESCRIPTION : To Provide the Module Id
// PARAMETER   :
// RETURN      : Module Id
// THROWS      :
//-------------------------------------------------------------------------------
int Dra::GetModuleId()
{
	return mModuleId;
}

//-------------------------------------------------------------------------------
// METHOD      : GetRoutingDetails
// DESCRIPTION : Get Routing Details from Routing.xml file
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      : Peer details
// THROWS      :
//-------------------------------------------------------------------------------
BOOLEAN Dra::GetRoutingDetails(DiameterMsg &msg, DiameterPeerEntry *&dest)
{
	std::multimap<int, std::string> codeMap;
	std::map<int, DictionaryData> supportedAVP;
	BOOLEAN lNewLogicFlag = false;

	std::string foundPeer;
	std::string avpValue;
	BOOLEAN invalidCode = false;

	list<ActivePeerData>::iterator Iterator;

	supportedAVP = mRouting->getSupportedAVP();

	std::string lLogText = LOG_DIAMETER_AVPS(msg);

	for (map<int, DictionaryData>::iterator it = supportedAVP.begin(); it != supportedAVP.end(); it++)
	{
		avpValue.clear();

		try
		{
			BOOLEAN lInterfaceObj = false;
			list<DiameterBaseInterface *> lList;

			if (msg.hdr.mApplId == AAA_Gx_APP_ID)
			{
				GX::CCRequest *lCCRequest = reinterpret_cast<GX::CCRequest *>(msg.baseClass.get());

				#pragma message("What is the purpose of NewLogicFlag?");
				AvpCodePathDet lAvpCodePathDet;
				if (true == mRouting->getAvpCodePathDet(msg.hdr.mApplId, it->first, lAvpCodePathDet))
				{
					lNewLogicFlag = true;
					int size = lAvpCodePathDet.avpCodePath.size();
					lInterfaceObj = lCCRequest->FindAll(&msg.rawbyteArray, lAvpCodePathDet.avpCodePath, size, 1, lList, true);
				}
				else
				{
					lNewLogicFlag = false;
					lInterfaceObj = lCCRequest->FindAll(&msg.rawbyteArray, it->first, lList, true);
				}
				if (!lInterfaceObj)
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Not Found NLF:%d\n", lLogText.c_str(), it->first, lNewLogicFlag));
				}
				else
				{
					for (auto *item : lList)
					{
						switch (item->GetDataType())
						{
						case UNSIGNED32_TYPE:
							avpValue = (reinterpret_cast<Unsigned32 *>(item))->ToString();
							break;
						case ENUMERATED_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER32_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER64_TYPE:
							avpValue = (reinterpret_cast<Integer64 *>(item))->ToString();
							break;
						case UNSIGNED64_TYPE:
							avpValue = (reinterpret_cast<Unsigned64 *>(item))->ToString();
							break;
						case OCTETSTRING_TYPE:
							avpValue = (reinterpret_cast<OctetString *>(item))->ToString();
							break;
						default:
						{
							invalidCode = true;
							break;
						}
						}

						if (invalidCode == false)
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Value:%s NLF:%d\n", lLogText.c_str(), it->first, avpValue.c_str(), lNewLogicFlag));
							codeMap.insert(make_pair(it->first, avpValue));
						}
					}
				}

				lList.clear();
			}
			else if (msg.hdr.mApplId == AAA_Ro_APP_ID)
			{
				RO::CCRequest *lCCRequest = reinterpret_cast<RO::CCRequest *>(msg.baseClass.get());
				lInterfaceObj = lCCRequest->FindAll(&msg.rawbyteArray, it->first, lList, true);
				if (!lInterfaceObj)
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Not Found\n", lLogText.c_str(), it->first));
				}
				else
				{
					for (auto *item : lList)
					{
						switch (item->GetDataType())
						{
						case UNSIGNED32_TYPE:
							avpValue = (reinterpret_cast<Unsigned32 *>(item))->ToString();
							break;
						case ENUMERATED_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER32_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER64_TYPE:
							avpValue = (reinterpret_cast<Integer64 *>(item))->ToString();
							break;
						case UNSIGNED64_TYPE:
							avpValue = (reinterpret_cast<Unsigned64 *>(item))->ToString();
							break;
						case OCTETSTRING_TYPE:
							avpValue = (reinterpret_cast<OctetString *>(item))->ToString();
							break;
						default:
						{
							invalidCode = true;
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d \n", lLogText.c_str(), it->first)); // TBC-Anshul 26-12-18
							break;
						}
						}

						if (invalidCode == false)
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Value:%s\n", lLogText.c_str(), it->first, avpValue.c_str()));
							codeMap.insert(make_pair(it->first, avpValue));
						}
					}
				}

				lList.clear();
			}
			else if (msg.hdr.mApplId == AAA_Rx_APP_ID)
			{
				RX::AARequest *lAARequest = reinterpret_cast<RX::AARequest *>(msg.baseClass.get());
				lInterfaceObj = lAARequest->FindAll(&msg.rawbyteArray, it->first, lList, true);
				if (!lInterfaceObj)
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Not Found\n", lLogText.c_str(), it->first));
				}
				else
				{
					for (auto *item : lList)
					{
						switch (item->GetDataType())
						{
						case UNSIGNED32_TYPE:
							avpValue = (reinterpret_cast<Unsigned32 *>(item))->ToString();
							break;
						case ENUMERATED_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER32_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER64_TYPE:
							avpValue = (reinterpret_cast<Integer64 *>(item))->ToString();
							break;
						case UNSIGNED64_TYPE:
							avpValue = (reinterpret_cast<Unsigned64 *>(item))->ToString();
							break;
						case OCTETSTRING_TYPE:
							avpValue = (reinterpret_cast<OctetString *>(item))->ToString();
							break;
						default:
						{
							invalidCode = true;
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d \n", lLogText.c_str(), it->first)); // TBC-Anshul 26-12-18
							break;
						}
						}
						if (invalidCode == false)
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Value:%s\n", lLogText.c_str(), it->first, avpValue.c_str()));
							codeMap.insert(make_pair(it->first, avpValue));
						}
					}
				}
				lList.clear();
			}
			else if (msg.hdr.mApplId == AAA_Sy_APP_ID)
			{
				SY::SLRequest *lSLRequest = reinterpret_cast<SY::SLRequest *>(msg.baseClass.get());
				lInterfaceObj = lSLRequest->FindAll(&msg.rawbyteArray, it->first, lList, true);
				if (!lInterfaceObj)
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Not Found\n", lLogText.c_str(), it->first));
				}
				else
				{
					for (auto *item : lList)
					{
						switch (item->GetDataType())
						{
						case UNSIGNED32_TYPE:
							avpValue = (reinterpret_cast<Unsigned32 *>(item))->ToString();
							break;
						case ENUMERATED_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER32_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER64_TYPE:
							avpValue = (reinterpret_cast<Integer64 *>(item))->ToString();
							break;
						case UNSIGNED64_TYPE:
							avpValue = (reinterpret_cast<Unsigned64 *>(item))->ToString();
							break;
						case OCTETSTRING_TYPE:
							avpValue = (reinterpret_cast<OctetString *>(item))->ToString();
							break;
						default:
						{
							invalidCode = true;
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d \n", lLogText.c_str(), it->first)); // TBC-Anshul 26-12-18
							break;
						}
						}
						if (invalidCode == false)
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Value:%s\n", lLogText.c_str(), it->first, avpValue.c_str()));
							codeMap.insert(make_pair(it->first, avpValue));
						}
					}
				}
				lList.clear();
			}
			else if (msg.hdr.mApplId == AAA_S6a_APP_ID)
			{
				cout<<"ULR Handling in DRA"<<endl;
				S6A::UpdateLocationRequest *lULRequest = reinterpret_cast<S6A::UpdateLocationRequest *>(msg.baseClass.get());
				lInterfaceObj = lULRequest->FindAll(&msg.rawbyteArray, it->first, lList, true);
				if (!lInterfaceObj)
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Not Found\n", lLogText.c_str(), it->first));
				}
				else
				{
					for (auto *item : lList)
					{
						switch (item->GetDataType())
						{
						case UNSIGNED32_TYPE:
							avpValue = (reinterpret_cast<Unsigned32 *>(item))->ToString();
							break;
						case ENUMERATED_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER32_TYPE:
							avpValue = (reinterpret_cast<Integer32 *>(item))->ToString();
							break;
						case INTEGER64_TYPE:
							avpValue = (reinterpret_cast<Integer64 *>(item))->ToString();
							break;
						case UNSIGNED64_TYPE:
							avpValue = (reinterpret_cast<Unsigned64 *>(item))->ToString();
							break;
						case OCTETSTRING_TYPE:
							avpValue = (reinterpret_cast<OctetString *>(item))->ToString();
							break;
						default:
						{
							invalidCode = true;
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d \n", lLogText.c_str(), it->first)); // TBC-Anshul 26-12-18
							break;
						}
						}
						if (invalidCode == false)
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s AVP Code:%d Value:%s\n", lLogText.c_str(), it->first, avpValue.c_str()));
							codeMap.insert(make_pair(it->first, avpValue));
						}
					}
				}
				lList.clear();
			}
			else
			{
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Application-Id:%s Not Supported\n", lLogText.c_str(), msg.hdr.mApplId));
				return false;
			}
		}
		catch (TssDiameterMsgException d)
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Caught Exception on Finding Routing details, Err:%s Msg:%s\n",
					 lLogText.c_str(), d.getErrorCode(), d.getErrMessage()));
		}
	}

	return mRouting->getPeer(codeMap, dest, msg.sessionId);
}

//-------------------------------------------------------------------------------
// METHOD      : ccInitialRequestRtxReceived
// DESCRIPTION : To Handle cc Requests. This is the entry point for all cc requests.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccInitialRequestRtxReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	if (mSourcePeerEntry == nullptr && mDestPeerEntry == nullptr)
	{
		ccInitialRequestReceived(msg, source, dest);
	}
	else
	{
		ccUpdateRequestReceived(msg, source, dest);
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccInitialRequestReceived
// DESCRIPTION : To Handle cc Initial Requests.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccInitialRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message, Type:AVP_BASED\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s CCR(I) Source:%s Route to Destination:%s\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

	this->StoreMsccUsu(msg);
}

//-------------------------------------------------------------------------------
// METHOD      : ccInitialAnswerReceived
// DESCRIPTION : To Handle cc Initial Answers.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccInitialAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	try
	{
		this->EvrWriter(msg);

		switch (msg->hdr.mApplId)
		{
		case AAA_Ro_APP_ID:
		{
			this->CheckCCAMsg(msg);
		}
		break;
		default:
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s undefine Application Id\n", lLogText.c_str()));
		}
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception Caught\n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccInitialAnswerReceived
// DESCRIPTION : To Handle cc Update Requests.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccUpdateRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	if (mDestPeerEntry != nullptr)
	{
		dest = mDestPeerEntry;
	}

	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (!mDestPeerEntry || (!mRouting->CheckPeerStatus(mDestPeerEntry)))
	{
		if (mDestPeerEntry)
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s CCR(U) Source:%s Destination:%s, Destination UNAVAILABLE, finding new route....\n",
					 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for Update message, Type:AVP_BASED\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));
			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		mDestPeerEntry = dest;
		mSourcePeerEntry = source;
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str())); // TBC-Anshul 26-12-18
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s CCR(U) Source:%s Route to Destination:%s\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

	this->StoreMsccUsu(msg);
}

//-------------------------------------------------------------------------------
// METHOD      : CheckCCAMsg
// DESCRIPTION : To processes message by conditionally invoking specific handlers
//				 based on configuration flags.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::CheckCCAMsg(DiameterMsg *msg)
{
	if (DRA_CONFIG_HDLR()->mMsccResultCodMapActiveFlag)
	{
		this->ReplaceResultCodeMSCC(msg);
	}

	if (DRA_CONFIG_HDLR()->mInputOutputOctetsActiveFlag)
	{
		this->CheckAndAddGUSOctets(msg);
	}

	if (DRA_CONFIG_HDLR()->mVolumeQuotaThresholdActiveFlag)
	{
		this->VolumeQuotaThreshold(msg);
	}

	if (DRA_CONFIG_HDLR()->mRelayDataOnErrToPcrfFlg)
	{
		this->RelayCCAToPcrf(msg);
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccUpdateAnswerReceived
// DESCRIPTION : To Handle cc Update Answers.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccUpdateAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	try
	{
		this->EvrWriter(msg);

		switch (msg->hdr.mApplId)
		{
		case AAA_Ro_APP_ID:
		{
			this->CheckCCAMsg(msg);
		}
		break;
		default:
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s undefine Application Id\n", lLogText.c_str()));
		}
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception Caught\n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ReplaceResultCodeMSCC
// DESCRIPTION : To updates unsupported MSCC result codes in Diameter messages 
//				 based on configurable mappings and conditions.
// PARAMETER   : DiameterMsg
// RETURN      : void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ReplaceResultCodeMSCC(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	regex lRegex((DRA_CONFIG_HDLR()->mOrignHostRegulerExp));
	string lOriginHost = msg->baseClass->getOriginHost()->ToString();

	if (regex_match(lOriginHost, lRegex))
	{
		if (DRA_CONFIG_HDLR()->mAndOrFlg)
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s AND_FLAG %d [UnitAction & TotalOctets] is 0 then change result code \n",
					 lLogText.c_str(), DRA_CONFIG_HDLR()->mAndOrFlg));
			try
			{
				auto lMSCC = reinterpret_cast<RO::CCAnswer *>(msg->baseClass.get())->getMultipleServicesCreditControlGrpList();
				for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)
				{
					int lGSU = 0;
					try
					{
						lGSU = (*it)->getGrantedServiceUnit()->getCCTotalOctets()->getValue();
					}
					catch (...)
					{
						lGSU = 0;
					}

					try
					{
						if ((*it)->getFinalUnitIndication()->getFinalUnitAction()->getValue() == 0 && lGSU == 0)
						{
							string lResultMSCC = to_string((*it)->getResultCode()->getValue());

							auto resultReplaced = DRA_CONFIG_HDLR()->mResultCodeMSCCMap.find(lResultMSCC);
							if (resultReplaced != DRA_CONFIG_HDLR()->mResultCodeMSCCMap.end())
							{
								(*it)->setResultCode()->setValue(resultReplaced->second);
								AAA_LOG((LM_INFO, "%T |DRA_APP| %s UnSupported MSCC ResultCode replaced with ResultCode:%d\n",
										 lLogText.c_str(), resultReplaced->second));
							}
							else
							{
								resultReplaced = DRA_CONFIG_HDLR()->mResultCodeMSCCMap.find("*");
								if (resultReplaced != DRA_CONFIG_HDLR()->mResultCodeMSCCMap.end())
								{
									(*it)->setResultCode()->setValue(resultReplaced->second);
									AAA_LOG((LM_INFO,
											 "%T |DRA_APP| %s UnSupported MSCC ResultCode replaced with defaultCode:%d\n",
											 lLogText.c_str(), resultReplaced->second));
								}
							}
						}
					}
					catch (...)
					{
						AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught ,while Processing MSCC ResultCode\n", lLogText.c_str()));
					}
				}
			}
			catch (...)
			{
				AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught while Processing MSCC Result code\n", lLogText.c_str()));
			}
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s AND_FLAG %d [UnitAction | TotalOctets] is 0 then change result code\n",
					 lLogText.c_str(), DRA_CONFIG_HDLR()->mAndOrFlg));
			try
			{
				auto lMSCC = reinterpret_cast<RO::CCAnswer *>(msg->baseClass.get())->getMultipleServicesCreditControlGrpList();
				for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)
				{
					int lFUI = 3;
					int lGSU = 0;
					try
					{
						lFUI = (*it)->getFinalUnitIndication()->getFinalUnitAction()->getValue();
					}
					catch (...)
					{
						lFUI = 3;
					}
					try
					{
						lGSU = (*it)->getGrantedServiceUnit()->getCCTotalOctets()->getValue();
					}
					catch (...)
					{
						lGSU = 0;
					}

					try
					{
						if (lFUI == TERMINATE || lGSU == 0)
						{
							string lResultMSCC = to_string((*it)->getResultCode()->getValue());

							auto resultReplaced = DRA_CONFIG_HDLR()->mResultCodeMSCCMap.find(lResultMSCC);
							if (resultReplaced != DRA_CONFIG_HDLR()->mResultCodeMSCCMap.end())
							{
								(*it)->setResultCode()->setValue(resultReplaced->second);
								AAA_LOG((LM_INFO, "%T |DRA_APP| %s UnSupported MSCC ResultCode replaced with ResultCode:%d\n",
										 lLogText.c_str(), resultReplaced->second));
							}
							else
							{
								resultReplaced = DRA_CONFIG_HDLR()->mResultCodeMSCCMap.find("*");
								if (resultReplaced != DRA_CONFIG_HDLR()->mResultCodeMSCCMap.end())
								{
									(*it)->setResultCode()->setValue(resultReplaced->second);
									AAA_LOG((LM_INFO,
											 "%T |DRA_APP| %s UnSupported MSCC ResultCode replaced with defaultCode\n",
											 lLogText.c_str()));
								}
							}
						}
					}
					catch (...)
					{
						// Log
						AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception caught ,while Processing MSCC Result Code\n",
								 lLogText.c_str()));
					}
				}
			}
			catch (...)
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception caught while Processing MSCC Result code\n", lLogText.c_str()));
			}
		}
	}
}

//-------------------------------------------------------------------------------
// METHOD      : CheckAndAddGUSOctets
// DESCRIPTION : To ensures the presence of CCInputOctets and CCOutputOctets in 
//				 Diameter messages, assigning default values if missing.
// PARAMETER   : DiameterMsg
// RETURN      : void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::CheckAndAddGUSOctets(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		regex lRegex((DRA_CONFIG_HDLR()->mOrignHostGSURegulerExp));
		string lOriginHost = msg->baseClass->getOriginHost()->ToString();

		if (regex_match(lOriginHost, lRegex))
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is MATCHED with configuration\n", lLogText.c_str()));

			auto lMSCC = reinterpret_cast<RO::CCAnswer *>(msg->baseClass.get())->getMultipleServicesCreditControlGrpList();

			for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)
			{
				try
				{
					auto lGsu = (*it)->getGrantedServiceUnit();

					if (lGsu)
					{
						AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s GSU AVP Present in Message  %d \n", lLogText.c_str(), lGsu));
						try
						{
							(*it)->getGrantedServiceUnit()->getCCInputOctets()->getValue();
						}
						catch (...)
						{
							(*it)->getGrantedServiceUnit()->setCCInputOctets()->setValue(DRA_CONFIG_HDLR()->mGSUccInputOctet);
							AAA_LOG((LM_INFO, "%T |DRA_APP| %s CCInputOctets is not present, assigning %d \n",
									 lLogText.c_str(), DRA_CONFIG_HDLR()->mGSUccInputOctet));
						}

						try
						{
							(*it)->getGrantedServiceUnit()->getCCOutputOctets()->getValue();
						}
						catch (...)
						{
							(*it)->getGrantedServiceUnit()->setCCOutputOctets()->setValue(DRA_CONFIG_HDLR()->mGSUccOutputOctet);
							AAA_LOG((LM_INFO, "%T |DRA_APP| %s CCOutputOctets is not present, assigning %d \n",
									 lLogText.c_str(), DRA_CONFIG_HDLR()->mGSUccOutputOctet));
						}
					}
					else
					{
						AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s GSU AVP Present in Message \n", lLogText.c_str()));
					}
				}
				catch (...)
				{
					AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught while processing GSU \n", lLogText.c_str()));
				}
			}
		}
	}
	catch (...)
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught \n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : VolumeQuotaThreshold
// DESCRIPTION : To assign VolumeQuotaThreshold to Diameter messages if 
//				 CCTotalOctets exceeds a configured threshold.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::VolumeQuotaThreshold(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		regex lRegex((DRA_CONFIG_HDLR()->mOrignHostGSURegulerExp));
		string lOriginHost = msg->baseClass->getOriginHost()->ToString();

		if (regex_match(lOriginHost, lRegex))
		{
			auto lMSCC = reinterpret_cast<RO::CCAnswer *>(msg->baseClass.get())->getMultipleServicesCreditControlGrpList();
			for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)
			{

				int lGSU = 0;
				try
				{
					lGSU = (*it)->getGrantedServiceUnit()->getCCTotalOctets()->getValue();
				}
				catch (...)
				{
					AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught,while processing CCTotalOctets \n", lLogText.c_str()));
					return;
				}

				try
				{
					(*it)->getVolumeQuotaThreshold()->getValue();
				}
				catch (...)
				{
					if (lGSU > DRA_CONFIG_HDLR()->mCCTotalOctetsThreshold)
					{
						(*it)->setVolumeQuotaThreshold()->setValue((lGSU * DRA_CONFIG_HDLR()->mVolumeQuotaThresholdPercentage / 100));
						AAA_LOG((LM_INFO, "%T |DRA_APP| %s VolumeQuotaThreshold is not Present new assign \n", lLogText.c_str()));
					}
					else
					{
						AAA_LOG((LM_INFO, "%T |DRA_APP| %s VolumeQuotaThreshold is not Present but CCTotalOctets is not crossing the Threshold Value \n", lLogText.c_str()));
					}
				}
			}
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Origin Host is not Present \n", lLogText.c_str()));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught,while processing VolumeQuotaThreshold \n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccTerminateRequestReceived
// DESCRIPTION : To Handle cc Terminate Requests. And to store the MSCC and USU
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccTerminateRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	if (mDestPeerEntry != nullptr)
	{
		dest = mDestPeerEntry;
	}

	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (!mDestPeerEntry || (!mRouting->CheckPeerStatus(mDestPeerEntry)))
	{
		if (mDestPeerEntry)
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s CCR(T) Source:%s Destination:%s, Destination UNAVAILABLE, finding new route....\n",
					 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for Terminate message, Type:AVP_BASED\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));
			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		mDestPeerEntry = dest;
		mSourcePeerEntry = source;
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str())); /// TBC-Anshul 28-Dec
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s CCR(T) Source:%s Route to Destination:%s\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

	this->StoreMsccUsu(msg);
}

//-------------------------------------------------------------------------------
// METHOD      : ccTerminateAnswerReceived
// DESCRIPTION : To Handle cc Terminate Answers.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccTerminateAnswerReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	try
	{
		this->EvrWriter(msg);

		switch (msg->hdr.mApplId)
		{
		case AAA_Ro_APP_ID:
		{
			this->CheckCCAMsg(msg);
		}
		break;
		default:
		{
		}
		}
	}
	catch (...)
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception Caught\n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccEventRequestReceived
// DESCRIPTION : To handles Diameter event requests by determining routing details, 
//				 updating destination information, and processing retransmissions.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccEventRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	if (mSourcePeerEntry == nullptr) // If its not null then its retransmitted message
	{
		std::string lLogText = LOG_DIAMETER_AVPS(*msg);
		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message, Type:AVP_BASED\n", lLogText.c_str()));

			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));
			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}

		mSourcePeerEntry = source;
		mDestPeerEntry = dest;

		try
		{
			if (dest->GetRealmName().size())
				msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
			msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
		}
		catch (...)
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str())); /// TBC-Anshul 28-dec
		}
	}
	else
	{
		mSourcePeerEntry = source;
		ccUpdateRequestReceived(msg, source, dest);
	}
}

