//-------------------------------------------------------------------------------
// METHOD      :
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::GenerateFile()
{
	time_t lCurrentTime;
	struct tm *lpTmStruct;

	if (NULL != gLicPeg)
	{
		fclose(gLicPeg);
		gLicPeg = NULL;
	}

	lCurrentTime = time(NULL);
	lpTmStruct = localtime(&lCurrentTime);
	snprintf(gLicPegFile, MAX_FILE_PATH + MAX_FILE_NAME, "%s/%02d%02d%02d_DraTraffic_GX.txt",
			 gLicPegFilePath, lpTmStruct->tm_mday, lpTmStruct->tm_mon + 1, lpTmStruct->tm_year % 100);

	gLicPeg = fopen(gLicPegFile, "a+");

	if (NULL == gLicPeg)
	{
		char lLogText[300];
		snprintf(lLogText, 300, "Unable to Open File:%s", gLicPegFile);
		// TssLogGenerator::mLog->GenerateLog( 500, lLogText);
		return;
	}
	fprintf(gLicPeg, "+----------------------------------------------------------------------+\n");
	std::list<DiameterPeerEntry *> *lPeerList = DIAMETER_PEER_TABLE()->GetPeerList();
	int i = 0;
	for (std::list<DiameterPeerEntry *>::iterator it = lPeerList->begin(); it != lPeerList->end(); it++, i++)
	{
		fprintf(gLicPeg, "PEER_%d   :><:  %s [%s]\n", i, (*it)->GetPeerName().c_str(), (!(*it)->IsClient()) ? "CLIENT" : "SERVER");
		(*it)->Peg()->ClearPeg();
		gClearFlag = 1;
	}

	fprintf(gLicPeg, "+----------------------------------------------------------------------+\n");
	fprintf(gLicPeg, "%6s #> %7s |%3s|%3s|%3s|%3s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%7s|%6s|%6s|%6s|%6s|%6s|%6s|%6s|\n",
			"Time", "PeerName", "CER", "CEA", "DWR", "DWA", "CCR-IS", "CCA-IS", "CCA-IF", "CCR-US", "CCA-US", "CCA-UF", "CCR-TS", "CCA-TS", "CCA-TF", "RAR-S", "RAA-S", "RAA-F", "Unexp", "EBT-R", "TBT-R", "M/S");
	fprintf(gLicPeg, "+----------------------------------------------------------------------+\n");

	fprintf(gLicPeg, "\n");
}
