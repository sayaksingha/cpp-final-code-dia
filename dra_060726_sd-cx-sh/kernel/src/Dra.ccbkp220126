		else if (resultCode == 5420)  // DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION
		{
			AAA_LOG((LM_WARNING, "%T |DRA_APP| %s S6a DSA: UNKNOWN_EPS_SUBSCRIPTION (5420)\n", lLogText.c_str()));
