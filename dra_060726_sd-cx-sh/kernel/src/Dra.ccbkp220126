//-------------------------------------------------------------------------------
// METHOD      : ccSTRequestReceived
// DESCRIPTION : This method handles the processing of a STR received in the Diameter protocol.
//				 It determines the appropriate destination peer for the message, performs routing
//				 checks, and updates the message's destination information.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccSTRequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	if (mDestPeerEntry != nullptr)
	{
		dest = mDestPeerEntry;
	}

	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (!mDestPeerEntry || (!mRouting->CheckPeerStatus(mDestPeerEntry)))
	{
		if (mDestPeerEntry)
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s STR Source:%s Destination:%s, Destination UNAVAILABLE, finding new route....\n",
					 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));

		if (AVP_BASED == mRouting->getRoutingType())
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for Update message, Type:AVP_BASED\n", lLogText.c_str()));

			// ModifiedBy-- Nandagopi. Date:01/07/2021
			//  Modified to form error response on Routing fails..
			if (false == this->GetRoutingDetails(*msg, dest))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		else
		{
			AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));
			if (!mRouting->getPeer(dest, msg->sessionId))
			{
				// ModifiedBy-- Nandagopi. Date:01/07/2021
				//  Modified to form error response on Routing fails..
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
				msg->internalRspFlag = true;
				return;
			}
			dest->Dump();
		}
		mDestPeerEntry = dest;
		mSourcePeerEntry = source;
	}

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s STR Source:%s Route to Destination:%s\n",
			 lLogText.c_str(), source->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

