//-------------------------------------------------------------------------------
// METHOD      : SyncSourceDest
// DESCRIPTION : Synchronizes the source and destination peer entries for Diameter messages.
// PARAMETER   :
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::SyncSourceDest(DiameterPeerEntry *source, DiameterPeerEntry *dest)
{
	// Below swapping is not added  HV to avoid retranmissiion issue
	//	mDestPeerEntry   = source;
	//	mSourcePeerEntry = dest;

	mDestPeerEntry = dest;
	mSourcePeerEntry = source;
}

#pragma message("Rework on Pegs and its display, for Code Reusability, manageability and Performance");
//-------------------------------------------------------------------------------
// METHOD      : DisplayPegDetails
// DESCRIPTION :
// PARAMETER   : DiameterPeerEntry, int, unsigned long &
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::DisplayPegDetails(DiameterPeerEntry *peerEntry, int index, unsigned long &tps)
{

	unsigned long cummulatedReq = peerEntry->Peg()->m_cummulatedReq;
	unsigned long cummulatedAns = peerEntry->Peg()->m_cummulatedAns;

	if (false == gClearFlag)
	{
		// gettimeofday(&gTimeValue, NULL);
		// gLocalTime = localtime(&(gTimeValue.tv_sec));

		peerEntry->Peg()->CummulateCount();

		if (peerEntry->Peg()->m_cummulatedReq >= cummulatedReq)
			cummulatedReq = peerEntry->Peg()->m_cummulatedReq - cummulatedReq;
		else
			peerEntry->Peg()->m_cummulatedReq = 0;

		if (peerEntry->Peg()->m_cummulatedAns >= cummulatedAns)
			cummulatedAns = peerEntry->Peg()->m_cummulatedAns - cummulatedAns;
		else
			peerEntry->Peg()->m_cummulatedReq = 0;

		if (cummulatedReq >= 0 && cummulatedAns >= 0)
			tps += (2 * cummulatedReq + 2 * cummulatedAns);
		else
			tps = 0;
	}
	else
	{
		cummulatedReq = 0;
		cummulatedAns = 0;
		peerEntry->Peg()->m_cummulatedReq = 0;
		peerEntry->Peg()->m_cummulatedAns = 0;
		tps = 0;
		gClearFlag = false;
	}
	fprintf(gLicPeg,
			"%c> PEER_%02d [%s]  |%-3u|%-3u|%-3u|%-3u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-7u|%-6u|%-6u|%-6u|%-6u|%-6u|%-6u|%-6lu|\n",
			'#',
			index,
			peerEntry->GetPeerStatus().c_str(),
			peerEntry->Peg()->m_cer,
			peerEntry->Peg()->m_cea_success,
			peerEntry->Peg()->m_dwr,
			peerEntry->Peg()->m_dwa_success,
			peerEntry->Peg()->m_ccr_initial,
			peerEntry->Peg()->m_cca_initial_success,
			peerEntry->Peg()->m_cca_initial_fail,
			peerEntry->Peg()->m_ccr_update,
			peerEntry->Peg()->m_cca_update_success,
			peerEntry->Peg()->m_cca_update_fail,
			peerEntry->Peg()->m_ccr_terminate,
			peerEntry->Peg()->m_cca_terminate_success,
			peerEntry->Peg()->m_cca_terminate_fail,
			peerEntry->Peg()->m_rar,
			peerEntry->Peg()->m_raa_success,
			peerEntry->Peg()->m_raa_fail,
			peerEntry->Peg()->m_unexpected,
			peerEntry->Peg()->m_error_bit,
			peerEntry->Peg()->m_retx_bit,
			(!peerEntry->IsClient()) ? cummulatedReq : cummulatedAns);

	fflush(gLicPeg);
}
