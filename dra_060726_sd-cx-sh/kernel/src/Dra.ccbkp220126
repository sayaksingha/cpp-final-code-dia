//-------------------------------------------------------------------------------
// METHOD      :
// DESCRIPTION : This SetAlarmForNextDay method is not used in the code, need to be removed
// PARAMETER   :
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::SetAlarmForNextDay()
{
	// time_t mktime(struct tm *tm);
	#pragma message("This SetAlarmForNextDay method is not used in the code, need to be removed");
	time_t lCurrentTime;
	time_t lNextTime;
	time_t lDiffTime;
	struct tm *lpTmStruct;

	lCurrentTime = time(NULL);
	lpTmStruct = localtime(&lCurrentTime);
	lpTmStruct->tm_hour = 23;
	lpTmStruct->tm_min = 59;
	lpTmStruct->tm_sec = 59;
	lNextTime = mktime(lpTmStruct);
	lDiffTime = lNextTime - lCurrentTime;
	lDiffTime = lDiffTime + 5; // Add Five For Correction
	alarm(lDiffTime);
}

//-------------------------------------------------------------------------------
// METHOD      : RelayCCAToPcrf
// DESCRIPTION : This method relays failed Credit-Control-Answer (CCA) messages 
//				 to the PCRF based on configuration and routing logic.
// PARAMETER   : DiameterMsg
// RETURN      : void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::RelayCCAToPcrf(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	try
	{
		if (msg->baseClass->getResultCode()->getValue() == AAA_SUCCESS)
		{
			return;
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s ResultCode:%d Checking OH...\n", lLogText.c_str(), msg->baseClass->getResultCode()->getValue()));
		}

		regex lRegex((DRA_CONFIG_HDLR()->mOrignHostGSURegulerExp));
		string lOriginHost = msg->baseClass->getOriginHost()->ToString();

		if (regex_match(lOriginHost, lRegex))
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is MATCHED with configuration\n", lLogText.c_str()));

			string lListName = "";
			if (!this->GetActivePeer(msg, lListName))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Failed to get Active Peer \n", lLogText.c_str()));
				if (DRA_CONFIG_HDLR()->mNoOfPrcfNodes == 1)
				{
					lListName = DRA_CONFIG_HDLR()->mDefPcrfNode;
				}
			}

			if (lListName.compare("") == 0)
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Failed to get Active Peer/Default node not configured \n", lLogText.c_str()));
			}
			else
			{
				std::shared_ptr<RO::CCAnswer> lCCASPtr = std::static_pointer_cast<RO::CCAnswer>(msg->baseClass);
				std::shared_ptr<RO::CCAnswer> lCCAnswer = make_shared<RO::CCAnswer>();

				lCCAnswer->mspByteArray = make_shared<byteArray>();
				memcpy(lCCAnswer->mspByteArray.get(), lCCASPtr->mspByteArray.get(), sizeof(byteArray));

				lCCAnswer->setDiameterMsgHeader(1, lCCASPtr->getCmdFlag(), lCCASPtr->getCmdCode(), lCCASPtr->getApplnId(),
												lCCASPtr->getHopByHopId(), lCCASPtr->getEndToEndId());
				lCCAnswer->setSessionId()->setValue((TEXT *)lCCASPtr->getSessionId()->getValue());

				if (-1 == DRA_PCRF_RELAY()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lCCAnswer), lListName))
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Send Failed Sending Again to PCRF\n", lLogText.c_str()));
					if (-1 == DRA_PCRF_RELAY()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lCCAnswer), lListName))
					{
						AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Sending Again PCRF\n", lLogText.c_str()));
					}
				}
			}
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is NOT MATCHED with configuration\n", lLogText.c_str()));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Exception caught \n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : RelayASRToPcrf
// DESCRIPTION : Message relay to pcrf redis
// PARAMETER   : DiameterMsg
// RETURN      : void
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::RelayASRToPcrf(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	try
	{
		regex lRegex((DRA_CONFIG_HDLR()->mOrignHostGSURegulerExp));
		string lOriginHost = msg->baseClass->getOriginHost()->ToString();
		if (regex_match(lOriginHost, lRegex))
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is MATCHED with configuration\n", lLogText.c_str()));

			string lListName = "";
			if (!this->GetActivePeer(msg, lListName))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Failed to get Active Peer\n", lLogText.c_str()));
				if (DRA_CONFIG_HDLR()->mNoOfPrcfNodes == 1)
				{
					lListName = DRA_CONFIG_HDLR()->mDefPcrfNode;
				}
			}

			if (lListName.compare("") == 0)
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Failed to get Active Peer/Default node not configured \n", lLogText.c_str()));
			}
			else
			{
				std::shared_ptr<BASE::AbortSessionRequest> lASRPtr = std::static_pointer_cast<BASE::AbortSessionRequest>(msg->baseClass);
				std::shared_ptr<BASE::AbortSessionRequest> lASReq = make_shared<BASE::AbortSessionRequest>();

				lASReq->setDiameterMsgHeader(1, lASRPtr->getCmdFlag(), lASRPtr->getCmdCode(), lASRPtr->getApplnId(),
											 lASRPtr->getHopByHopId(), lASRPtr->getEndToEndId());
				lASReq->setCmdCode(lASRPtr->getCmdCode()); // TBC
				lASReq->setSessionId()->setValue((TEXT *)lASRPtr->getSessionId()->getValue());

				if (-1 == DRA_PCRF_RELAY()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lASReq), lListName))
				{
					AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Send Failed Sending Again to PCRF\n", lLogText.c_str()));
					if (-1 == DRA_PCRF_RELAY()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lASReq), lListName))
					{
						AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Sending Again PCRF\n", lLogText.c_str()));
					}
				}
			}
		}
		else
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is NOT MATCHED with configuration\n", lLogText.c_str()));
		}
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception caught \n", lLogText.c_str()));
	}
}

//-------------------------------------------------------------------------------
// METHOD      : GetActivePeer
// DESCRIPTION : To retrieves the active peer for a Diameter session by checking
//				 local and external session data, ensuring peer availability 
//				 and alias mapping.
// PARAMETER   : DiameterMsg, string &
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
bool Dra::GetActivePeer(DiameterMsg *msg, string &lListName)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	AAA_JobData *data = NULL;

	string key = to_string(AAA_Gx_APP_ID) + string(";") + msg->sessionId;
	bool ret = DIAMETER_NEW_SESSION_DB().Lookup(key, (void **)&data);

	if (ret)
	{
		try
		{
			Dra *session = reinterpret_cast<Dra *>(data);

			if (!session->mDestPeerEntry || !session->mRouting->CheckPeerStatus(session->mDestPeerEntry))
			{
				if (session->mDestPeerEntry)
				{
					AAA_LOG((LM_ERROR, "%T |DRA_APP| %s DH:%s, Dest UNAVAILABLE....\n",
							 lLogText.c_str(), session->mDestPeerEntry->GetPeerName().c_str()));
				}
				return false;
			}

			std::string lPeerName = session->mDestPeerEntry->GetPeerName();
			if (!mRouting->getAlias(lPeerName, lListName))
			{
				AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Gx Session Info FOUND. Peer Alias is not FOUND in Map\n", lLogText.c_str()));
				lListName = lPeerName;
			}
			return true;
		}
		catch (...)
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception While checking Activepcrf peer\n", lLogText.c_str()));
			return false;
		}
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Gx Session not present. Checking in redis..!\n", lLogText.c_str()));

		try
		{
			SyncDccaProxySessionData syncData;
			memset(&syncData, 0, sizeof(SyncDccaProxySessionData));

			strcpy(syncData.sessionId, msg->sessionId.c_str());
			syncData.appId = AAA_Gx_APP_ID;

			if (GetSyncSessionData(syncData))
			{
				std::string lPeerName = syncData.destName;

				if (lPeerName.size())
				{
					DiameterPeerEntry *peer = NULL;

					peer = DIAMETER_PEER_TABLE()->Lookup(lPeerName);
					if (peer)
					{
						if (peer->IsOpen())
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| PEER:%s STATUS:AVAILABLE SID:%s\n", lPeerName.c_str(), msg->sessionId.c_str()));
						}
						else
						{
							AAA_LOG((LM_DEBUG, "%T |DRA_APP| PEER:%s STATUS:UNAVAILABLE SID:%s\n", lPeerName.c_str(), msg->sessionId.c_str()));
							return false;
						}
					}
				}
				else
					return false;

				if (!mRouting->getAlias(lPeerName, lListName))
				{
					AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Gx Session Info FOUND. Peer Alias is not FOUND in Map\n", lLogText.c_str()));
					lListName = lPeerName;
				}
				return true;
			}
			else
			{
				AAA_LOG((LM_INFO, "%T |DRA_APP| %s Gx Session lookup failed.\n", lLogText.c_str()));
				return false;
			}
		}
		catch (...)
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception While checking Activepcrf peer\n", lLogText.c_str()));
			return false;
		}
	}
}

//-------------------------------------------------------------------------------
// METHOD      : EvrWriter
// DESCRIPTION : processes and writes Event Records (EVRs) for Diameter messages 
//				 based on application ID and configuration.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::EvrWriter(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	switch (msg->hdr.mApplId)
	{
	case AAA_Ro_APP_ID:
	{
		string lApplId = to_string(msg->hdr.mApplId);
		int lRet = DIAMETER_CFG_EVR_INFO()->IsPresent(lApplId);

		if (lRet != 0)
		{
			regex lRegex(DRA_CONFIG_HDLR()->mOHForMsccEvr);
			string lOriginHost = msg->baseClass->getOriginHost()->ToString();
			if (!regex_match(lOriginHost, lRegex))
			{
				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is not matched for Mscc EVR\n", lLogText.c_str()));
				return;
			}

			std::shared_ptr<RO::CCAnswer> lCCASPtr = std::static_pointer_cast<RO::CCAnswer>(msg->baseClass);
			MSCC_DECODE();

			if (lRet == 1 || (lRet == 2 && (msg->baseClass->getCCRequestType()->getValue() == 3)))
			{
				std::shared_ptr<RO::CCAnswer> lCCAnswer = make_shared<RO::CCAnswer>();

				lCCAnswer->mspByteArray = make_shared<byteArray>();
				memcpy(lCCAnswer->mspByteArray.get(), lCCASPtr->mspByteArray.get(), sizeof(byteArray));

				lCCAnswer->setDiameterMsgHeader(1, lCCASPtr->getCmdFlag(), lCCASPtr->getCmdCode(),
												lCCASPtr->getApplnId(), lCCASPtr->getHopByHopId(), lCCASPtr->getEndToEndId());

				lCCAnswer->setSessionId()->setValue((TEXT *)lCCASPtr->getSessionId()->getValue());

				AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Writing Evr into Queue\n", lLogText.c_str()));
				// enqueue
				DRA_DETAILED_EVR_WRITER()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lCCAnswer), mMsccInfo);
			}
		}
	}
	break;
	default:
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Application not Supported to write Evrs\n", lLogText.c_str()));
	}
	}
}

//-------------------------------------------------------------------------------
// METHOD      : StoreMsccUsu
// DESCRIPTION : To processes and stores MSCC and USU data from Diameter messages 
//				 for tracking usage metrics.
// PARAMETER   : DiameterMsg
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::StoreMsccUsu(DiameterMsg *msg)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);
	switch (msg->hdr.mApplId)
	{
	case AAA_Ro_APP_ID:
	{
		string lApplId = to_string(msg->hdr.mApplId);
		int lRet = DIAMETER_CFG_EVR_INFO()->IsPresent(lApplId);

		if (lRet == 0)
		{
			return;
		}

		regex lRegex(DRA_CONFIG_HDLR()->mOHForMsccEvr);
		string lOriginHost = msg->baseClass->getOriginHost()->ToString();
		if (!regex_match(lOriginHost, lRegex))
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| %s Origin Host is not matched for Mscc EVR\n", lLogText.c_str()));
			return;
		}

		try
		{
			auto lMSCC = reinterpret_cast<RO::CCRequest *>(msg->baseClass.get())->getMultipleServicesCreditControlGrpList();
			for (auto it = lMSCC->begin(); it != lMSCC->end(); ++it)
			{
				MsccInfo lMsccInfo;
				int lRG = 0;
				try
				{
					lRG = (*it)->getRatingGroup()->getValue();
				}
				catch (...)
				{
					lRG = 0;
				}

				try
				{
					auto lUsu = (*it)->getUsedServiceUnitGrpList();
					if (lUsu->begin() != (*it)->getUsedServiceUnitGrpList()->end())
					{
						lMsccInfo.mUsuCurrent = (*lUsu->begin())->getCCTotalOctets()->getValue();
					}
				}
				catch (...)
				{
					lMsccInfo.mUsuCurrent = 0;
				}

				auto lMsccInfoIt = mMsccInfo.find(lRG);
				if (lMsccInfoIt != mMsccInfo.end())
				{
					lMsccInfoIt->second.mUsuTotal = lMsccInfoIt->second.mUsuTotal + lMsccInfo.mUsuCurrent;
					lMsccInfoIt->second.mUsuCurrent = lMsccInfo.mUsuCurrent;
				}
				else
				{
					lMsccInfo.mUsuTotal = lMsccInfo.mUsuCurrent;
					mMsccInfo[lRG] = lMsccInfo;
				}
			}
		}
		catch (...)
		{
			AAA_LOG((LM_DEBUG, "%T |DRA_APP| Exception while decoding Mscc to store Usu\n"));
		}
	}
	break;
	case AAA_Gx_APP_ID:
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| Application not support evr\n"));
	}
	break;
	default:
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| Application not support evr\n"));
	}
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccTccTimeExpired
// DESCRIPTION : To  handles session expiration by generating and sending a 
//				 Credit-Control-Answer (CCA) with event records if applicable.
// PARAMETER   : string &, int
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccTccTimeExpired(string &lSessionId, int lApplId)
{
	switch (lApplId)
	{
	case AAA_Ro_APP_ID:
	{
		string lApplIdstr = to_string(lApplId);
		int lRet = DIAMETER_CFG_EVR_INFO()->IsPresent(lApplIdstr);

		if (lRet != 0)
		{
			std::shared_ptr<RO::CCAnswer> lCCAnswer = make_shared<RO::CCAnswer>();
			lCCAnswer->setDiameterMsgHeader(1, 0, 272, lApplId, 0, 0);
			lCCAnswer->setSessionId()->setValue((TEXT *)lSessionId.c_str());
			DRA_DETAILED_EVR_WRITER()->SendReq(std::dynamic_pointer_cast<DiameterBase>(lCCAnswer), mMsccInfo, true);
		}
	}
	break;
	default:
	{
		AAA_LOG((LM_DEBUG, "%T |DRA_APP| Application not support to Evr SID:%s\n", lSessionId.c_str()));
	}
	}
}

//-------------------------------------------------------------------------------
// METHOD      : ccAARequestReceived
// DESCRIPTION : To handles the processing of an AAR in the Diameter protocol. It determines
//				 the appropriate destination peer, performs routing checks, and updates
//				 the message's destination information.
// PARAMETER   : DiameterMsg, DiameterPeerEntry
// RETURN      :
// THROWS      :
//-------------------------------------------------------------------------------
void Dra::ccAARequestReceived(DiameterMsg *msg, DiameterPeerEntry *source, DiameterPeerEntry *&dest)
{
	std::string lLogText = LOG_DIAMETER_AVPS(*msg);

	if (AVP_BASED == mRouting->getRoutingType())
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message, Type:AVP_BASED\n", lLogText.c_str()));

		if (false == this->GetRoutingDetails(*msg, dest))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}
	else
	{
		AAA_LOG((LM_INFO, "%T |DRA_APP| %s Routing Configured for the message\n", lLogText.c_str()));

		if (!mRouting->getPeer(dest, msg->sessionId))
		{
			AAA_LOG((LM_ERROR, "%T |DRA_APP| %s No Active peers\n", lLogText.c_str()));
			msg->internalRspFlag = true;
			return;
		}
		dest->Dump();
	}

	mSourcePeerEntry = source;
	mDestPeerEntry = dest;

	try
	{
		msg->baseClass->setDestinationRealm()->setValue(const_cast<char *>(dest->GetRealmName().c_str()));
		msg->baseClass->setDestinationHost()->setValue(const_cast<char *>(dest->GetPeerName().c_str()));
	}
	catch (...)
	{
		AAA_LOG((LM_ERROR, "%T |DRA_APP| %s Exception cought while setting Destination identity\n", lLogText.c_str()));
	}

	AAA_LOG((LM_CRITICAL, "%T |DRA_APP| %s AAR Source:%s Route to Destination:%s\n",
			 lLogText.c_str(), mSourcePeerEntry->GetPeerName().c_str(), mDestPeerEntry->GetPeerName().c_str()));
}

